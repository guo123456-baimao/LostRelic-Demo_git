# ---------- 本项目自定义 ----------
# 手工备份
_backups/
# MCP 调试截图，不属于项目内容
/[Aa]ssets/Screenshots/
/[Aa]ssets/Screenshots.meta
# Claude Code 本机权限配置（每台机器不同）
.claude/settings.local.json

# 注意：不要整体忽略 *.meta。Unity 用 .meta 保存资源 GUID，
# 丢掉工程自有资源的 .meta 会让所有 prefab / 场景引用断链。
# 下面只忽略「已被排除的第三方二进制素材」各自配套的 .meta——
# 源文件都不在库里了，它的 .meta 也没有意义。

# ---------- 第三方重型素材：不入库 ----------
# 约 384MB 的模型 / 贴图 / 音频来自 Asset Store 等第三方，多数授权禁止
# 二次分发，且不体现工程能力，单次 HTTPS 推送也会被掐断。
#
# 只剔除二进制本体，工程结构全部保留：219 个 prefab、4 个 Animator
# 控制器、10 个动画片段、24 个材质都是文本 YAML，照常入库，所以组件
# 配置、动画状态机、场景编排在仓库里是完整可读的。
#
# 克隆后场景内模型贴图为缺失状态（洋红色），补齐方式见 README。
/Assets/Assets/**/*.png
/Assets/Assets/**/*.png.meta
/Assets/Assets/**/*.jpg
/Assets/Assets/**/*.jpg.meta
/Assets/Assets/**/*.jpeg
/Assets/Assets/**/*.jpeg.meta
/Assets/Assets/**/*.tga
/Assets/Assets/**/*.tga.meta
/Assets/Assets/**/*.psd
/Assets/Assets/**/*.psd.meta
/Assets/Assets/**/*.tif
/Assets/Assets/**/*.tif.meta
/Assets/Assets/**/*.tiff
/Assets/Assets/**/*.tiff.meta
/Assets/Assets/**/*.exr
/Assets/Assets/**/*.exr.meta
/Assets/Assets/**/*.hdr
/Assets/Assets/**/*.hdr.meta
/Assets/Assets/**/*.cubemap
/Assets/Assets/**/*.cubemap.meta
/Assets/Assets/**/*.wav
/Assets/Assets/**/*.wav.meta
/Assets/Assets/**/*.mp3
/Assets/Assets/**/*.mp3.meta
/Assets/Assets/**/*.ogg
/Assets/Assets/**/*.ogg.meta
/Assets/Assets/**/*.aiff
/Assets/Assets/**/*.aiff.meta
/Assets/Assets/**/*.fbx
/Assets/Assets/**/*.fbx.meta
/Assets/Assets/**/*.obj
/Assets/Assets/**/*.obj.meta
/Assets/Assets/**/*.blend
/Assets/Assets/**/*.blend.meta
/Assets/Assets/**/*.glb
/Assets/Assets/**/*.glb.meta
/Assets/Assets/**/*.gltf
/Assets/Assets/**/*.gltf.meta
/Assets/Assets/**/*.bin
/Assets/Assets/**/*.bin.meta
/Assets/Assets/**/*.ttf
/Assets/Assets/**/*.ttf.meta
/Assets/Assets/**/*.otf
/Assets/Assets/**/*.otf.meta
/Assets/Assets/**/*.mov
/Assets/Assets/**/*.mov.meta
/Assets/Assets/**/*.mp4
/Assets/Assets/**/*.mp4.meta

# 例外：这三个目录不是美术素材，整体保留
# XLua = Lua 绑定层，Plugins = XLua 原生库，UI = 界面图标（0.1MB）
!/Assets/Assets/XLua/**
!/Assets/Assets/Plugins/**
!/Assets/Assets/UI/**
